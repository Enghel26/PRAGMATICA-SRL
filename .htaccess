<IfModule mod_rewrite.c>
  RewriteEngine On
  DirectorySlash Off

  # 1. Servir index.html cuando la URL sea /Inicio y Soluciones.html cuando sea /Servicios
  RewriteRule ^(.*/)?Inicio/?$ $1index.html [NC,L]
  RewriteRule ^(.*/)?Servicios/?$ $1Soluciones.html [NC,L]
  RewriteRule ^(.*/)?Servicio/?$ $1Soluciones.html [NC,L]

  # 2. Servir internamente el archivo .html correspondiente si existe
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
